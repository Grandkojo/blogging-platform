type User {
    id: ID
    name: String
    email: String
    role: String
}

type Post {
    id: ID
    userId: ID
    title: String
    content: String
    status: String
    author: String
    createdAt: String
    publishedDate: String
    commentCount: Int
    tags: [String]
}

type Comment {
    id: ID
    userId: ID
    postId: ID
    content: String
}

type Tag {
    id: ID
    tag: String
}

type Review {
    id: ID
    postId: ID
    userId: ID
    rating: Int
    message: String
}

type Query {
    getPosts(query: String, page: Int, size: Int, sortBy: String): [Post]
    getPostss: [Post]
    getUserss: [User]
    getCommentss: [Comment]
    getCommentt(id: ID!): Comment
    getPostCommentss(postId: ID!): [Comment]
    getReviewss: [Review]
    getTagss: [Tag]
    getPost(id: ID!): Post
}

type Mutation {
    # Post mutations — userId is derived from the authenticated JWT; do not pass it.
    createPost(
        title: String!,
        content: String!,
        status: String!
    ): ID

    updatePost(
        id: ID!,
        title: String!,
        content: String!,
        status: String!
    ): Boolean

    deletePost(
        id: ID!
    ): Boolean

    # Comment mutations
    createComment(
        postId: ID!,
        content: String!
    ): Boolean

    updateComment(
        id: ID!,
        content: String!
    ): Boolean

    deleteComment(
        id: ID!
    ): Boolean

    # Review mutations
    createReview(
        postId: ID!,
        rating: Int!,
        message: String!
    ): Boolean

    updateReview(
        id: ID!,
        postId: ID!,
        rating: Int!,
        message: String!
    ): Boolean

    deleteReview(
        id: ID!
    ): Boolean

    # Tag mutations
    createTag(
        tag: String!
    ): Boolean

    linkTagToPost(
        tagId: ID!,
        postId: ID!
    ): Boolean

    unlinkTagsFromPost(
        postId: ID!
    ): Boolean
}
