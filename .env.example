# Copy to .env and fill in real values. Do not commit .env (it is in .gitignore).

# Database (dev / default profile)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/blogging_platform_new?allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# JWT
JWT_SECRET=your-long-random-secret-at-least-32-chars
JWT_TTL=PT1H
JWT_ISSUER=https://blogging-platform

# Google OAuth2 (required for Google login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS (optional; comma-separated origins; dev has a default)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
